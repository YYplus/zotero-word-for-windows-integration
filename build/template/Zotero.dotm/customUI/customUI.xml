<?xml version="1.0"?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui">
  <ribbon>
    <tabs>
      <tab id="ZoteroTab" getLabel="ZoteroRibbon.ZoteroTabLabel" insertBeforeMso="TabAddIns" keytip="C">
        <group id="ZoteroGroup" image="zoteroz16" label="Zotero">
          <button id="InsertZoteroCitationButton" getLabel="ZoteroRibbon.ZoteroRibbonGetLabel" size="large" image="addEditZoteroCitation" onAction="ZoteroRibbon.ZoteroRibbonAddEditCitation" getSupertip="ZoteroRibbon.ZoteroRibbonGetSupertip" tag="Add/Edit Citation||Insert a new citation, or edit the citation at the current cursor position" keytip="C"/>
          <button id="InsertZoteroBibliographyButton" getLabel="ZoteroRibbon.ZoteroRibbonGetLabel" size="large" image="addEditZoteroBibliography" onAction="ZoteroRibbon.ZoteroRibbonAddEditBibliography" getSupertip="ZoteroRibbon.ZoteroRibbonGetSupertip" tag="Add/Edit Bibliography||Insert a new bibliography, or edit the existing bibliography, at the current cursor position" keytip="B"/>
          <separator id="ZoteroSeparator1"/>
          <button id="InsertZoteroAnnotationButton" getLabel="ZoteroRibbon.ZoteroRibbonGetLabel" size="large" image="addZoteroAnnotation" onAction="ZoteroRibbon.ZoteroRibbonAddAnnotation" getSupertip="ZoteroRibbon.ZoteroRibbonGetSupertip" tag="Add Annotation||Insert an annotation at the current cursor position" keytip="A"/>
          <button id="InsertZoteroNoteButton" getLabel="ZoteroRibbon.ZoteroRibbonGetLabel" size="large" image="addZoteroNote" onAction="ZoteroRibbon.ZoteroRibbonAddNote" getSupertip="ZoteroRibbon.ZoteroRibbonGetSupertip" tag="Add Note||Insert a new note at the current cursor position" keytip="N"/>
          <separator id="ZoteroSeparator2"/>
          <button id="ZoteroSetDocPrefs" getLabel="ZoteroRibbon.ZoteroRibbonGetLabel" image="zoteroDocPrefs" onAction="ZoteroRibbon.ZoteroRibbonSetDocPrefs" getSupertip="ZoteroRibbon.ZoteroRibbonGetSupertip" tag="Document Preferences||Change the citation style or locale" keytip="P"/>
          <button id="RefreshZotero" getLabel="ZoteroRibbon.ZoteroRibbonGetLabel" image="zoteroRefresh" onAction="ZoteroRibbon.ZoteroRibbonRefresh" getSupertip="ZoteroRibbon.ZoteroRibbonGetSupertip" tag="Refresh||Update all citations to reflect changes" keytip="R"/>
          <button id="ZoteroRemoveCodes" getLabel="ZoteroRibbon.ZoteroRibbonGetLabel" image="zoteroRemoveCodes" onAction="ZoteroRibbon.ZoteroRibbonRemoveCodes" getSupertip="ZoteroRibbon.ZoteroRibbonGetSupertip" tag="Unlink Citations||Remove all Zotero field codes and unlink from Zotero library" keytip="U"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
