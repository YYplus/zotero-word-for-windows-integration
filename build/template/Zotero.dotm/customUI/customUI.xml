<?xml version="1.0"?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui">
  <ribbon>
    <tabs>
      <tab id="ZoteroTab" getLabel="ZoteroRibbon.ZoteroTabLabel" insertBeforeMso="TabAddIns" keytip="C">
        <group id="ZoteroGroup" image="zoteroz16" label="Zotero">
          <button id="InsertZoteroCitationButton" getLabel="ZoteroRibbon.ZoteroRibbonGetLabel" size="large" image="addEditZoteroCitation" onAction="ZoteroRibbon.ZoteroRibbonAddEditCitation" getSupertip="ZoteroRibbon.ZoteroRibbonGetSupertip" tag="Add/Edit Citation||添加/编辑引注||Insert a new citation, or edit the citation at the current cursor position||在当前光标位置插入新引注，或编辑现有引注" keytip="C"/>
          <button id="InsertZoteroBibliographyButton" getLabel="ZoteroRibbon.ZoteroRibbonGetLabel" size="large" image="addEditZoteroBibliography" onAction="ZoteroRibbon.ZoteroRibbonAddEditBibliography" getSupertip="ZoteroRibbon.ZoteroRibbonGetSupertip" tag="Add/Edit Bibliography||添加/编辑参考文献表||Insert a new bibliography, or edit the existing bibliography, at the current cursor position||在当前光标位置插入新的参考文献表，或编辑现有参考文献表" keytip="B"/>
          <separator id="ZoteroSeparator1"/>
          <button id="InsertZoteroAnnotationButton" getLabel="ZoteroRibbon.ZoteroRibbonGetLabel" size="large" image="addZoteroAnnotation" onAction="ZoteroRibbon.ZoteroRibbonAddAnnotation" getSupertip="ZoteroRibbon.ZoteroRibbonGetSupertip" tag="Add Annotation||添加注释||Insert an annotation at the current cursor position||在当前光标位置插入注释" keytip="A"/>
          <button id="InsertZoteroNoteButton" getLabel="ZoteroRibbon.ZoteroRibbonGetLabel" size="large" image="addZoteroNote" onAction="ZoteroRibbon.ZoteroRibbonAddNote" getSupertip="ZoteroRibbon.ZoteroRibbonGetSupertip" tag="Add Note||添加笔记||Insert a new note at the current cursor position||在当前光标位置插入新笔记" keytip="N"/>
          <separator id="ZoteroSeparator2"/>
          <button id="ZoteroSetDocPrefs" getLabel="ZoteroRibbon.ZoteroRibbonGetLabel" image="zoteroDocPrefs" onAction="ZoteroRibbon.ZoteroRibbonSetDocPrefs" getSupertip="ZoteroRibbon.ZoteroRibbonGetSupertip" tag="Document Preferences||文档首选项||Change the citation style or locale||更改引注样式或语言" keytip="P"/>
          <button id="RefreshZotero" getLabel="ZoteroRibbon.ZoteroRibbonGetLabel" image="zoteroRefresh" onAction="ZoteroRibbon.ZoteroRibbonRefresh" getSupertip="ZoteroRibbon.ZoteroRibbonGetSupertip" tag="Refresh||刷新||Update all citations to reflect changes||更新所有引注以反映更改" keytip="R"/>
          <button id="ZoteroRemoveCodes" getLabel="ZoteroRibbon.ZoteroRibbonGetLabel" image="zoteroRemoveCodes" onAction="ZoteroRibbon.ZoteroRibbonRemoveCodes" getSupertip="ZoteroRibbon.ZoteroRibbonGetSupertip" tag="Unlink Citations||断开引注链接||Remove all Zotero field codes and unlink from Zotero library||移除所有 Zotero 域代码并断开与 Zotero 文献库的链接" keytip="U"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
